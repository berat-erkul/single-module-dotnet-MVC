@{
    ViewData["Title"] = "Excel Yükle";
}

<h1>Excel yükle</h1>
<p class="text-muted">Yüklediğin belge müdür onayına gider. Müdür karar verene kadar değiştirebilir veya silebilirsin.</p>

@* Dosya yüklemek için enctype="multipart/form-data" şart. Spring'de de aynı (MultipartFile). *@
<form asp-action="Upload" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        @* name="file" → controller'daki Upload(IFormFile file) parametresine bağlanır. *@
        <input type="file" name="file" accept=".xlsx" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Yükle</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

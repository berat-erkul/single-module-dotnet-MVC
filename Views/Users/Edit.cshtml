@model UserFormViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<h1>Kullanıcı düzenle</h1>
<p class="text-muted">Şifreyi boş bırakırsan değişmez.</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <partial name="_UserForm" model="Model" />
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

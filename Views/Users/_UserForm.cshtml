@* Partial view: Create ve Edit'in ortak form alanları. "_" ile başlaması konvansiyon (tek başına sayfa değil).
   Spring/Thymeleaf: th:fragment="userForm" + th:replace="~{users/form :: userForm}" *@
@model UserFormViewModel

@* Tüm form hataları (alana bağlı olmayanlar dahil). Thymeleaf: th:errors="*{*}" / #fields.hasGlobalErrors() *@
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    @* asp-for: label metnini [Display]'den, input'un name/value/type'ını property'den üretir. Thymeleaf: th:field="*{fullName}" *@
    <label asp-for="FullName" class="form-label"></label>
    <input asp-for="FullName" class="form-control" />
    <span asp-validation-for="FullName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Password" class="form-label"></label>
    <input asp-for="Password" class="form-control" />
    <span asp-validation-for="Password" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Role" class="form-label"></label>
    @* Html.GetEnumSelectList: enum değerlerinden <option> listesi üretir. Thymeleaf: th:each="r : ${T(...Role).values()}" *@
    <select asp-for="Role" asp-items="Html.GetEnumSelectList<Role>()" class="form-select"></select>
</div>

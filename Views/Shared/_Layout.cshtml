@* Ana şablon: navbar + flash mesajlar + sayfanın içeriği (@RenderBody). Spring/Thymeleaf: layout.html + layout:fragment="content" *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* ViewData["Title"]: her view kendi başlığını yazar. Spring: model.addAttribute("title", ...) *@
    <title>@ViewData["Title"] - FirmaPortal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    @* "~/" = wwwroot kökü. asp-append-version: dosya değişince ?v=hash ekler (cache kırma). *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            @* asp-controller/asp-action → doğru URL'i üretir (/Users). Spring/Thymeleaf: th:href="@{/users}" *@
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">FirmaPortal</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Kullanıcılar</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Documents" asp-action="Index">Belgeler</a></li>
            </ul>
            @* "User" = giriş yapan kişi. Spring/Thymeleaf: sec:authorize="isAuthenticated()" *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="navbar-text me-3">@User.Identity.Name (@User.GetRole())</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Çıkış</button>
                </form>
            }
            else
            {
                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Giriş</a>
            }
        </div>
    </nav>

    <main class="container">
        @* TempData flash mesajları (controller'da TempData["Success"] = ...). Spring: [[${success}]] flash attribute *@
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        @* Sayfanın kendi içeriği buraya gelir. Spring/Thymeleaf: <div layout:fragment="content"> *@
        @RenderBody()
    </main>
</body>
</html>
